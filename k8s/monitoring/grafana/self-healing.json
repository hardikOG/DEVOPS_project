    {
      "id": 21,
      "type": "table",
      "title": "Alerts",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "Value": true,
              "cluster": true,
              "job": true,
              "instance": true,
              "team": true
            }
          }
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Chaos",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "changes(healer_chaos_injections_total[10s]) > 0",
        "step": "5s",
        "titleFormat": "Chaos: {{kind}} on {{service}}"
      }
    ]
  }
}
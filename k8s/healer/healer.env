HEALER_NAMESPACE=self-healing
HEALER_MANAGED_LABEL=selfheal/managed=true
HEALER_RECONCILE_INTERVAL=2
HEALER_COOLDOWN_SECONDS=30
HEALER_BUDGET_MAX_ACTIONS=6
HEALER_BUDGET_WINDOW_SECONDS=600
HEALER_CRASHLOOP_RESTARTS=2
HEALER_RECOVERY_TIMEOUT_SECONDS=180
HEALER_DRY_RUN=false
CHAOS_ENABLED=true
PROMETHEUS_URL=http://prometheus.monitoring.svc:9090
PROMETHEUS_PUBLIC_URL=http://localhost:30090
GRAFANA_PUBLIC_URL=http://localhost:30030
ALERTMANAGER_PUBLIC_URL=http://localhost:30093
JENKINS_PUBLIC_URL=http://localhost:8080
